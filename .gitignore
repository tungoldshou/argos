# macOS / logs
.DS_Store
*.log

# transient Seatbelt sandbox profiles written at runtime
.argos_sandbox.sb
.argos_run.sb

# local env (dev keys — never commit)
.env.local
.env*.local
# CLAUDE.md is tracked (dev guide for Claude Code working on Argos) — not ignored.
# Root AGENTS.md is tracked as the Codex project guide. Keep other AGENTS.md files
# ignored so user-project fixtures or copied dev clones do not slip into commits.
AGENTS.md
!/AGENTS.md

# codegraph index
.codegraph

# ignore local .claude state (settings, locks) but DO track shared project skills
.claude/*
!.claude/skills/

# QA verification screenshots (throwaway)
screenshots/

# python
__pycache__/
*.pyc
*.egg-info/
.coverage
.pytest_cache/
.venv/

# PyInstaller arm64 单 binary 产物(打包态,不进 git)
/build/
/dist/
*.spec.bak

#superpowers
.superpowers

#claude
.claude
